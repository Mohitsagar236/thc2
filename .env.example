# Theme System Environment Variables
# Copy to .env.local and fill in with your actual values
# NEVER commit .env.local to git

# Verdaccio Registry Configuration
# Used in GitHub Actions for publishing theme packages
VERDACCIO_URL=https://verdaccio.company.com
VERDACCIO_TOKEN=<get-from-github-secrets>

# CDN Configuration
# Used for uploading theme bundles to CDN
CDN_URL=https://cdn.company.com/themes
CDN_BUCKET=company-themes-cdn
CDN_REGION=us-east-1
CDN_ACCESS_KEY=<get-from-github-secrets>
CDN_SECRET_KEY=<get-from-github-secrets>

# Frontend runtime bundle loading (Vite-exposed)
VITE_THEME_STABLE_URL=https://cdn.company.com/themes/stable/all-themes.js
VITE_THEME_BUNDLE_TIMEOUT_MS=6000

# Module Federation remote URLs for host shell
VITE_DASHBOARD_REMOTE_URL=http://localhost:5001/assets/remoteEntry.js
VITE_ADMIN_REMOTE_URL=http://localhost:5002/assets/remoteEntry.js
VITE_USER_REMOTE_URL=http://localhost:5003/assets/remoteEntry.js

# Theme Build Configuration
THEME_OUTPUT_DIR=dist/theme
THEME_BUNDLE_VERSION=1.0.0
NODE_ENV=production

# GitHub Actions Secrets (set in repository, not in .env)
# - VERDACCIO_TOKEN: NPM authentication token
# - CDN_UPLOAD_KEY: AWS/CDN credentials
# - CDN_BUCKET: S3 bucket name
# - CDN_REGION: AWS region for CDN
# - VERDACCIO_URL: Registry URL

# How to get secrets:
# 1. VERDACCIO_TOKEN: npm login at your Verdaccio instance, copy token
# 2. CDN credentials: Create IAM user in AWS with S3 access
# 3. Set in GitHub: Settings > Secrets and variables > Actions
